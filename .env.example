# FirstKill
#
# Default in this checkout: Robinhood Chain paper (`ENABLED_CHAINS` below).
# Solana extras (paid RPC, Jupiter, Helius) only if you enable `solana`.
#
# Optional: HELIUS_API_KEY (Solana holders), BIRDEYE_API_KEY (candles),
# COPE_API_KEY (Fomo profiles). Dexscreener is free.
#
# BNB: ZEROEX_API_KEY. Hood swaps Uniswap on-chain, no 0x key.
#
# Fomo / Moby / Padre are not execution venues. Label wallets for copy signal.

# paper | live
# Nothing in this repo will spend real money while MODE=paper.
MODE=paper

# Comma-separated. solana, bnb, robinhood_chain.
# robinhood_broker is the US brokerage (BTC/ETH) - not used. Robinhood Chain
# (Pons / Pools.trade) is `robinhood_chain`.
ENABLED_CHAINS=solana,bnb,robinhood_chain

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# A paid RPC is not optional for this workload. Public RPC will rate-limit you
# out of every trade that matters.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=

# Base58 secret key of the trading wallet. Keep a small balance here; this is a
# hot wallet by definition. Use a KMS/HSM signer in production.
SOLANA_PRIVATE_KEY=

# https://portal.jup.ag - required for api.jup.ag/swap/v2
JUPITER_API_KEY=

# Optional websocket firehose of new pump.fun launches.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# ---------------------------------------------------------------------------
# EVM chains (BNB Chain 56, Base 8453, Robinhood Chain 4663)
# ---------------------------------------------------------------------------
# EVM hot wallets. One key per chain. EVM_PRIVATE_KEY is the fallback if a
# per-chain key is empty.
EVM_PRIVATE_KEY=
BNB_PRIVATE_KEY=
BASE_PRIVATE_KEY=
ROBINHOOD_CHAIN_PRIVATE_KEY=

BNB_RPC_URL=https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# https://dashboard.0x.org - aggregated routing on BNB + Base
ZEROEX_API_KEY=

# Robinhood Chain is not on 0x, so it routes through Uniswap V3 directly.
# Verified on chain 4663; override if Uniswap redeploys.
RH_CHAIN_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
RH_CHAIN_QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
RH_CHAIN_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD97

# ---------------------------------------------------------------------------
# Robinhood Crypto brokerage API (US only, majors only - not memecoins)
# https://docs.robinhood.com/crypto/trading
# ---------------------------------------------------------------------------
RH_API_KEY=
# base64 of the raw 32-byte Ed25519 seed
RH_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Data providers (read-only signal sources)
# ---------------------------------------------------------------------------
# Dexscreener needs no key. Birdeye/Helius are optional accelerators.
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# Optional. Cope Capital is the Fomo research graph (handles → wallets,
# leaderboard). Used only to know which Fomo profiles sit in a token.
# Leave blank: only wallets you paste into config/whales.toml count.
COPE_API_KEY=

# MobyScreener has no public API. Paste whale wallets into config/whales.toml;
# hold % and buy/sell come from on-chain holders + trades.

# Optional. Light X search on buy (CA / $ticker / official handle).
# Without it the visor still shows the Dexscreener twitter URL; last-post age
# and institutional shill weight stay unmeasured and are not a veto.
TWITTER_BEARER_TOKEN=

# Optional. Bubblemaps Data API (cluster/bundle overlay, including robinhood).
# Without it we still compute a one-hop funding cluster on Solana.
BUBBLEMAPS_API_KEY=

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
STATE_DIR=state
LOG_LEVEL=INFO
# Optional Telegram alerting for fills, kill-switch trips and weight rollbacks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
